{
  "name": "temp-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-seo-pages.mjs",
    "lint": "eslint .",
    "library:build": "node scripts/build-library.mjs",
    "library:check": "node scripts/build-library.mjs --check",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish always",
    "test:unit": "node --test \"scripts/tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:sql": "node supabase/tests/next-features.test.mjs && node supabase/tests/chapter-publishing.test.mjs && node supabase/tests/cover-uploads.test.mjs && node supabase/tests/novel-language.test.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:e2e:cloud": "playwright test -c playwright.cloud.config.ts",
    "dev:cloud": "node scripts/dev-supabase/server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.106.1",
    "@tiptap/extension-collaboration": "^3.30.1",
    "@tiptap/extension-collaboration-caret": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-mention": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/y-tiptap": "^3.0.12",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "serve": "^14.2.6",
    "tippy.js": "^6.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet-async": "^1.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.1.0",
    "ws": "^8.22.1"
  },
  "build": {
    "appId": "com.novelist.workspace",
    "productName": "Novelist Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Aruhaaa",
        "repo": "Novel-Worskspace-WebApp"
      }
    ]
  }
}
