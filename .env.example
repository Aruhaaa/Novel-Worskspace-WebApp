# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional. Which "Continue with ..." buttons the sign-in screen shows: google, apple (comma separated).
# Set each provider up in Supabase first (supabase/README.md), or the button leads to an error page.
VITE_AUTH_PROVIDERS=

# Optional. Set to "on" once the notify-email function is deployed (supabase/README.md), so Preferences offers "By email".
VITE_NOTIFY_EMAIL=
